load seafar
stroke 60,600,0.2 200,598,0.6 360,601,0.2
dip
stroke 420,626,0.2 560,623,0.6 700,627,0.2
dip
stroke 760,606,0.2 900,603,0.6 1060,607,0.2
load seanear
stroke 120,650,0.2 260,647,0.6 420,651,0.2
dip
stroke 520,676,0.2 680,672,0.7 860,677,0.2
dip
stroke 900,654,0.2 1040,651,0.6 1190,655,0.2
dip
stroke 40,700,0.2 200,696,0.7 380,701,0.2
load sealight
stroke 300,728,0.2 460,724,0.7 640,729,0.2
dip
stroke 700,706,0.2 860,702,0.6 1040,707,0.2
dip
stroke 60,752,0.2 240,748,0.7 430,753,0.2
dip
stroke 560,762,0.2 740,757,0.7 930,763,0.2
dip
stroke 980,742,0.2 1090,739,0.6 1200,743,0.2
load seamid
stroke 180,774,0.2 360,770,0.6 540,775,0.2
dip
stroke 640,738,0.2 800,734,0.6 960,739,0.2

# --- the headland ---------------------------------------------------------------------
mix clifflight  = ochre 2, white 3, sienna 1
mix cliffmid    = ochre 2, sienna 2, white 1
mix cliffwarm   = ochre 2, sienna 1, cadyellow 0.5, white 1
mix cliffshadow = umber 2, ultramarine 1, alizarin 0.5, white 1
mix grassfar    = sap 2, cadyellow 1, white 2
mix grasslight  = sap 1, cadyellow 2, white 2
mix grassdeep   = sap 2, viridian 1, ultramarine 0.3
mix rock        = umber 2, ultramarine 1

dry
# block in the whole face, the brush leaning with the strata
