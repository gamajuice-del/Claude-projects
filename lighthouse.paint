# Lighthouse on the headland - painted by hand, stroke by stroke.
# Every line below is one movement of the brush.

canvas 1200 900  216 178 128

# --- the tubes ---------------------------------------------------------------
tube white        252 250 244
tube naples       250 226 150
tube cadyellow    252 208 22
tube ochre        202 152 62
tube cadred       226 42 30
tube alizarin     150 22 52
tube sienna       142 72 36
tube umber        70 46 32
tube ultramarine  30 46 150
tube cobalt       36 84 176
tube cerulean     44 136 196
tube viridian     18 112 84
tube sap          72 112 40
tube black        28 26 30

# --- the sky -------------------------------------------------------------------
mix skytop  = cobalt 3, ultramarine 1, white 2
mix skymid  = cerulean 3, cobalt 1, white 4
mix skylow  = cerulean 1, white 4
mix skyglow = white 7, naples 2, cerulean 1

brush flat 120
load skytop
stroke -30,28 300,40 700,22 1230,36
dip
stroke 1230,92 800,80 420,98 -30,84
dip
stroke -30,148 350,140 760,156 1230,142
load skymid
stroke 1230,204 760,214 380,198 -30,210
dip
stroke -30,262 400,270 820,256 1230,268
dip
stroke 1230,318 800,326 400,312 -30,322
load skylow
stroke -30,372 380,366 800,380 1230,370
dip
stroke 1230,422 800,430 400,418 -30,426
load skyglow
stroke -30,470 400,476 800,468 1230,474
dip
stroke 1230,512 800,516 400,510 -30,514

# soften the joins: a clean, soft brush scrubbed up and down across each seam,
# then drawn lightly along it
brush flat 90 pickup 0.06 flow 0.8
stroke 0,120 45,232 90,120 135,232 180,120 225,232 270,120 315,232 360,120 405,232 450,120 495,232 540,120 585,232 630,120 675,232 720,120 765,232 810,120 855,232 900,120 945,232 990,120 1035,232 1080,120 1125,232 1170,120 1210,232
clean
stroke 1200,290 1155,402 1110,290 1065,402 1020,290 975,402 930,290 885,402 840,290 795,402 750,290 705,402 660,290 615,402 570,290 525,402 480,290 435,402 390,290 345,402 300,290 255,402 210,290 165,402 120,290 75,402 30,290 -10,402
clean
stroke 0,400 45,496 90,400 135,496 180,400 225,496 270,400 315,496 360,400 405,496 450,400 495,496 540,400 585,496 630,400 675,496 720,400 765,496 810,400 855,496 900,400 945,496 990,400 1035,496 1080,400 1125,496 1170,400 1210,496
clean
stroke -30,150 300,156 640,146 940,156 1230,150
clean
stroke 1230,200 900,206 600,196 300,206 -30,200
clean
stroke -30,320 300,326 640,316 940,326 1230,320
clean
stroke 1230,372 900,378 600,368 300,378 -30,372
clean
stroke -30,430 300,436 640,426 940,436 1230,430
clean
stroke 1230,470 900,474 600,466 300,474 -30,470

# --- clouds, worked into the wet sky ----------------------------------------------
mix cloudlight  = white 8, naples 1
mix cloudmid    = white 6, ultramarine 0.5, alizarin 0.25
mix cloudshadow = white 4, ultramarine 1, alizarin 0.4, umber 0.2

# the big cumulus: a grey-lilac mass first...
brush round 90
load cloudmid
stroke 170,262 260,248 360,255 460,250 560,262
dip
stroke 190,225 270,190 350,170 440,185 520,225
dip
stroke 300,150 350,128 400,150
# ...then the sunlit tops of each lobe, turning the brush over the form
brush round 70
load cloudlight
stroke 150,250 160,215 195,192 235,200
dip
stroke 215,190 228,145 270,118 315,128
dip
stroke 300,128 325,92 370,84 405,112
dip
stroke 395,125 425,108 465,118 485,150
dip
stroke 480,180 510,168 545,185 555,215
dip
stroke 548,238 575,228 598,244
brush round 60
load cloudlight
stroke 190,228 240,205 290,180
dip
stroke 300,165 350,140 400,150
dip
stroke 420,160 460,165 500,195
dip
stroke 230,238,0.7 320,216,0.7 420,216,0.7 510,236,0.7
# shadow on the far side of the lobes and along the base
brush round 40
load cloudmid
stroke 245,232,0.5 275,244,0.7 310,237,0.5
dip
stroke 395,205,0.5 430,223,0.7 468,214,0.5
dip
stroke 330,190,0.4 352,199,0.5 372,190,0.4
brush round 36
load cloudshadow
stroke 175,282,0.6 250,290,0.6 330,284,0.6 410,292,0.6 490,284,0.6 560,278,0.6
brush round 50 pickup 0.06 flow 0.7
stroke 180,262 230,290 280,264 330,292 380,266 430,292 480,266 530,288 570,264
clean
stroke 160,294 300,302 450,300 585,286
# the brightest lights, last
brush round 30
load white
stroke 158,228 172,204 200,192
dip
stroke 226,170 240,140 272,122
dip
stroke 312,112 330,92 366,86
dip
stroke 404,122 428,110 458,116
dip
stroke 490,176 512,168 536,178

# a smaller cloud, upper right
brush round 70
load cloudmid
stroke 975,205 1050,190 1130,196 1195,210
brush round 54
load cloudlight
stroke 962,208 972,178 1004,160 1036,172
dip
stroke 1030,168 1050,132 1096,120 1132,146
dip
stroke 1128,160 1158,148 1192,160 1206,190
dip
stroke 990,200,0.7 1060,180,0.7 1140,186,0.7 1190,200,0.7
brush round 30
load cloudshadow
stroke 985,222,0.5 1060,230,0.6 1140,226,0.6 1200,218,0.5
brush round 44 pickup 0.06 flow 0.7
stroke 975,210 1010,232 1050,212 1090,234 1130,212 1170,232 1205,210
clean
stroke 960,236 1060,242 1160,238 1215,226
brush round 24
load white
stroke 968,196 980,174 1008,162
dip
stroke 1044,160 1060,134 1096,124
dip
stroke 1136,158 1160,150 1186,160

# thin far clouds low over the horizon
brush round 20
load cloudlight
stroke 50,452,0.2 130,446,0.8 220,452,0.2
dip
stroke 400,470,0.2 500,463,0.8 610,468,0.2
dip
stroke 180,488,0.2 260,484,0.6 330,488,0.2
dip
stroke 450,440,0.2 520,436,0.5 580,440,0.2

# --- the sea: laid in bands that shift from deep blue to turquoise -----------------
mix seafar   = ultramarine 3, viridian 1, white 1
mix seamid   = cerulean 3, viridian 2, white 1
mix seanear  = viridian 2, cerulean 1, white 3, cadyellow 0.3
mix seafar2  = seafar 1, seamid 1
mix seamid2  = seamid 1, seanear 1
mix sealight = seanear 1, white 1

brush flat 60
load seafar
stroke -20,548 1220,548
dip
stroke 1220,570 800,573 400,569 -20,572
load seafar2
stroke -20,594 400,597 800,592 1220,596
dip
stroke 1220,618 800,621 400,616 -20,620
load seamid
stroke -20,642 400,645 800,640 1220,644
dip
stroke 1220,666 800,669 400,664 -20,668
dip
stroke -20,690 400,693 800,688 1220,692
load seamid2
stroke 1220,714 800,717 400,712 -20,716
dip
stroke -20,738 400,741 800,736 1220,740
